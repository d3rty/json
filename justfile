    cd demo && pnpm run lint:fix

# Clean demo dependencies
demo-clean:
    @echo "🧹 Cleaning demo dependencies..."
    cd demo && rm -rf node_modules pnpm-lock.yaml

# Serve demo locally
demo-serve:
    @echo "📡  Serving demo/ at http://localhost:8080"
    cd demo && python3 -m http.server 8080
